{
  "manifest_version": 3,
  "name": "Google Forms Question Collector - Thu thập câu hỏi",
  "version": "1.0.0",
  "description": "Tự động thu thập câu hỏi, đáp án, điểm số từ Google Forms. Hỗ trợ gom nhiều trang và xuất ra Word, Markdown, Excel, CSV, JSON, Aiken.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "https://docs.google.com/forms/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Thu thập câu hỏi Google Forms",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "quiz_app.html",
        "quiz_app.js",
        "icons/*"
      ],
      "matches": [
        "https://docs.google.com/*",
        "<all_urls>"
      ]
    }
  ]
}